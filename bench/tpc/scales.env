# Approximate Snappy-Parquet footprints for publishable TPC scales (bytes).
# Used by prepare.sh size checks (±40% tolerance). Values are binary GiB/MiB.
#
# SF1    ~500 MiB
# SF100  ~10 GiB
# SF300  ~31 GiB
# SF1000 ~130 GiB

TARGET_BYTES_1=524288000
TARGET_BYTES_100=10737418240
TARGET_BYTES_300=33285996544
TARGET_BYTES_1000=139586437120
