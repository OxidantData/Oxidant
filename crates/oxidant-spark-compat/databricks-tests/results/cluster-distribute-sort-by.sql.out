-- Authored golden (Databricks SQL language manual: CLUSTER BY / DISTRIBUTE BY / SORT BY).
-- !query
CREATE OR REPLACE TEMPORARY VIEW sales (region STRING, amount INT) AS VALUES
  ('west', 100), ('east', 200), ('west', 150), ('east', 50), ('south', 75)
-- !query schema
struct<>
-- !query output


-- !query
SELECT region, amount FROM sales CLUSTER BY region
-- !query schema
struct<region:string,amount:int>
-- !query output
east	200
east	50
south	75
west	100
west	150


-- !query
SELECT region, amount FROM sales DISTRIBUTE BY region SORT BY region, amount
-- !query schema
struct<region:string,amount:int>
-- !query output
east	50
east	200
south	75
west	100
west	150


-- !query
SELECT region, amount FROM sales DISTRIBUTE BY region SORT BY amount DESC
-- !query schema
struct<region:string,amount:int>
-- !query output
east	200
west	150
west	100
south	75
east	50


-- !query
SELECT region FROM sales DISTRIBUTE BY region SORT BY region LIMIT 3
-- !query schema
struct<region:string>
-- !query output
east
east
south
