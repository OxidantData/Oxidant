-- Authored golden (Databricks SQL language manual: hash functions).
-- !query
SELECT sha('abc') AS a, sha1('abc') AS b, sha1('') AS c
-- !query schema
struct<a:string,b:string,c:string>
-- !query output
a9993e364706816aba3e25717850c26c9cd0d89d	a9993e364706816aba3e25717850c26c9cd0d89d	da39a3ee5e6b4b0d3255bfef95601890afd80709


-- !query
SELECT sha2('abc', 224) AS a
-- !query schema
struct<a:string>
-- !query output
23097d223405d8228642a477bda255b32aadbce4bda0b3f7e36c9da7


-- !query
SELECT sha2('abc', 256) AS a, sha2('abc', 0) AS b
-- !query schema
struct<a:string,b:string>
-- !query output
ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad	ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad


-- !query
SELECT sha2('abc', 384) AS a
-- !query schema
struct<a:string>
-- !query output
cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7


-- !query
SELECT sha2('abc', 512) AS a
-- !query schema
struct<a:string>
-- !query output
ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f


-- !query
SELECT sha2('abc', 100) AS a
-- !query schema
struct<a:string>
-- !query output
NULL


-- !query
SELECT crc32('abc') AS a, crc32('') AS b
-- !query schema
struct<a:bigint,b:bigint>
-- !query output
891568578	0


-- !query
SELECT sha1(CAST(NULL AS STRING)) AS a, crc32(CAST(NULL AS STRING)) AS b
-- !query schema
struct<a:string,b:bigint>
-- !query output
NULL	NULL
