[Unit]
Description=Weft instance bootstrap (env, spill mount, DNS, shard index)
Documentation=https://github.com/weftlabs/weft
After=network-online.target
Wants=network-online.target
Before=weft-driver.service weft-worker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/weft/bootstrap.sh
ExecStop=/usr/local/lib/weft/bootstrap.sh --deregister
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
