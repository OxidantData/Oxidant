[Unit]
Description=Weft Arrow Flight worker
Documentation=https://github.com/weftlabs/weft
# Requires+After weft-bootstrap: the worker must not start before bootstrap
# has written /etc/weft/weft.env (shard index) and upserted its Route53 A
# record. weft-bootstrap never starts this unit from inside its oneshot —
# that closes a dependency cycle and deadlocks boot (KAN-58). UserData starts
# this unit on first boot; the multi-user.target graph does on reboots.
After=network-online.target weft-bootstrap.service
Wants=network-online.target
Requires=weft-bootstrap.service

[Service]
Type=simple
User=weft
Group=weft
EnvironmentFile=-/etc/weft/weft.env
WorkingDirectory=/var/lib/weft
ExecStart=/usr/local/bin/weft worker --port 50561
Restart=on-failure
RestartSec=5
LimitNOFILE=1048576
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/weft /tmp
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
